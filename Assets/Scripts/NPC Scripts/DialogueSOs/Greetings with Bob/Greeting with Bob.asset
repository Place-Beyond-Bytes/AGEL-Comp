  m_Script: {fileID: 11500000, guid: 2649f57a122554f589f5ffffa749986c, type: 3}
  m_Name: Greeting with Bob
  m_EditorClassIdentifier: 
  lines:
  - speaker: {fileID: 11400000, guid: be72870669a66497ab94a1984ac758b9, type: 2}
    text: Hello, User!
  - speaker: {fileID: 11400000, guid: be72870669a66497ab94a1984ac758b9, type: 2}
    text: I heard you just released a new devlog for Willard, talking about animation!
  - speaker: {fileID: 11400000, guid: e9be7da87b92343dab812e3d731c6b67, type: 2}
    text: Sure did! You should check it out, Bob!
  options:
  - optionText: Tell me more!
    nextDialogue: {fileID: 11400000, guid: d5ee46bb9879b48619498a1c8406fae5, type: 2}
  - optionText: No interested.
    nextDialogue: {fileID: 11400000, guid: 1f5d4fe648d9a42fc828365ca1b552af, type: 2}
